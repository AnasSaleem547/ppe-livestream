# Copy to .env and fill in your Cloudinary credentials.
# Model selection and processing thresholds are in backend/core/config.py.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Live backend only. Keep the camera address and password on the server.
LIVE_CAMERA_URL=
LIVE_BACKEND_URL=http://127.0.0.1:8011
